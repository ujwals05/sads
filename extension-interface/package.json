{
  "name": "sads-agent",
  "displayName": "SADS Agent",
  "description": "Security-Aware Dependency Selection AI Coding Agent",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:sads-agent.helloWorld",
    "onCommand:sads-agent.openChat",
    "onView:sads.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sads",
          "title": "SADS",
          "icon": "media/sads.svg"
        }
      ]
    },
  "views": {
    "sads": [
      {
        "id": "sads.chatView",
        "name": "SADS Assistant",
        "type": "webview"
      }
    ]
  },
    "commands": [
      {
        "command": "sads-agent.helloWorld",
        "title": "SADS: Test Extension Command"
      },
      {
        "command": "sads-agent.openChat",
        "title": "SADS: Open Assistant"
      }
    ]

  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:webview": "npm --prefix webview-ui run build",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
